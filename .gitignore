# Secrets — never commit them (use .env locally, GitHub Secrets in CI)
.env
*.pem

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
