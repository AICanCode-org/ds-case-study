# Copy to .env (never commit .env). Everything works without any of these.
API_PORT=8000
EXPORT=2026-05
# Serve another artefact, e.g. the R track's model after `docker compose --profile train up`:
# MODEL_PATH=/runs/r/model.json
# Optional AI explainer (OpenAI-compatible API; a local Ollama needs no key):
AI_PROVIDER=offline
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_TIMEOUT_MS=4000
