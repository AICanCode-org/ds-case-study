{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICanCode-org/ds-case-study/contract/model.schema.json",
  "title": "ChurnCast model artefact (out/model.json, models/churncast-*.json)",
  "description": "Language-neutral: any track can write it, the API can serve it. Schema changes are additive (1.0 -> 1.1 adds monitoring_reference and lineage); a 1.0 reader ignores the fields it does not know.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "model_version",
    "kind",
    "target",
    "experiment",
    "features",
    "intercept",
    "coefficients",
    "feature_means",
    "high_risk_threshold",
    "base_rate",
    "training",
    "test_metrics",
    "generator"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "name": {
      "const": "churncast"
    },
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "logistic_regression"
    },
    "target": {
      "const": "churned_next_month"
    },
    "experiment": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "intercept": {
      "type": "number"
    },
    "coefficients": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "feature_means": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "high_risk_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "base_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "training": {
      "type": "object",
      "required": [
        "export",
        "contract_version",
        "snapshots",
        "rows",
        "churners"
      ],
      "properties": {
        "export": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "contract_version": {
          "type": "string"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "churners": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "test_metrics": {
      "type": "object",
      "required": [
        "auc",
        "average_precision",
        "brier",
        "ece",
        "precision_at_top",
        "recall_at_top"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "monitoring_reference": {
      "type": "object",
      "description": "1.1: decile edges and shares of every feature and of the score on the training rows (for PSI)"
    },
    "lineage": {
      "type": "object",
      "description": "1.1: where the model came from (parent model, refit window, calibration month, gate decision)"
    },
    "generator": {
      "type": "object",
      "required": [
        "track",
        "version"
      ],
      "properties": {
        "track": {
          "enum": [
            "python",
            "sql",
            "r"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
